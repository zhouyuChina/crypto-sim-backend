# 数据库配置
# 请根据您的本地 PostgreSQL 配置修改以下参数
# 如果有密码，格式为: postgresql://username:your_password@localhost:5432/crypto_sim
DATABASE_URL="postgresql://postgres@localhost:5432/crypto_sim"

# JWT 配置
JWT_ACCESS_TOKEN_SECRET="your-super-secret-access-token-key-here-change-me"
JWT_REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-here-change-me"

# Redis 配置
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# 邮件配置（可选）
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USER="your-email@example.com"
MAIL_PASSWORD="your-email-password"
MAIL_FROM="no-reply@example.com"

# SMTP 郵件驗證配置
# 本地開發推薦使用 163 郵箱或 QQ 郵箱
# 生產環境建議使用 Gmail

# 163 郵箱配置（推薦）
SMTP_HOST="smtp.163.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@163.com"
SMTP_PASS="your-auth-code"
EMAIL_FROM="your-email@163.com"
EMAIL_FROM_NAME="加密货币交易平台"

# QQ 郵箱配置（備選）
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@qq.com"
# SMTP_PASS="your-16-digit-auth-code"
# EMAIL_FROM="your-email@qq.com"
# EMAIL_FROM_NAME="加密货币交易平台"

# Gmail 配置（生產環境）
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-specific-password"
# EMAIL_FROM="your-email@gmail.com"
# EMAIL_FROM_NAME="Crypto Trading Platform"

# 市场数据配置（可选）
BINANCE_WS_BASE_URL="wss://stream.binance.com:9443/ws"
BINANCE_SYMBOLS="btcusdt,ethusdt,adausdt"
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"

# 应用配置
NODE_ENV="development"
HTTP_HOST="0.0.0.0"
HTTP_PORT="3000"

# 认证配置
# 开发模式下跳过 JWT 验证（true=跳过验证，false=需要验证）
# 生产环境务必设置为 false
AUTH_SKIP_JWT_VERIFICATION="true"


